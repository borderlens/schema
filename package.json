{
  "name": "@borderlens/schema",
  "description": "Shared Zod schemas and inferred TypeScript types for the Borderlens ecosystem.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=26.13"
  },
  "packageManager": "pnpm@12.16.1",
  "files": [
    "dist"
  ],
  "imports": {
    "#src/*": "./dist/*",
    "#base": "./dist/schemas/base/index.js",
    "#category": "./dist/schemas/category/index.js",
    "#class": "./dist/schemas/class/index.js",
    "#part": "./dist/schemas/part/index.js",
    "#special-effects": "./dist/schemas/special-effects/index.js",
    "#stats": "./dist/schemas/stats/index.js",
    "#utils": "./dist/schemas/utils/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm clean && tsc",
    "lint": "eslint src --no-error-on-unmatched-pattern --quiet",
    "lint:fix": "eslint src --no-error-on-unmatched-pattern --quiet --fix",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "zod": "^4.6.7"
  }
}
